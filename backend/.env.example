# Copiar a .env y completar. El .env real no se versiona (.gitignore).

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-poc-key-no-usar-en-produccion

# Agente conversacional — Claude y OpenAI son alternativas intercambiables.
# AGENT_MODE=mock   -> respuestas determinísticas sin LLM (por defecto)
# AGENT_MODE=claude -> usa la API de Anthropic (requiere ANTHROPIC_API_KEY)
# AGENT_MODE=openai -> usa la API de OpenAI    (requiere OPENAI_API_KEY)
AGENT_MODE=mock

# Si AGENT_MODE=claude
AGENT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Si AGENT_MODE=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
